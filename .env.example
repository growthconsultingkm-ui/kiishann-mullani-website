# ─────────────────────────────────────────────────────────────
# Copy this file to `.env.local` for local development, and add the
# same variables in your hosting provider (e.g. Vercel → Settings →
# Environment Variables) for production. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Final public URL of the site, no trailing slash. Used for canonical
# URLs, the sitemap, robots.txt and social previews.
# Example: https://www.yourdomain.com
NEXT_PUBLIC_SITE_URL=

# ── Contact form delivery (Resend — https://resend.com) ──────────
# Only RESEND_API_KEY is required. Create the Resend account with
# growthconsultingkm@gmail.com. The key is only ever used on the server.
RESEND_API_KEY=
# Optional — defaults to site.config.ts → contact.email.
CONTACT_TO_EMAIL=
# Optional — defaults to onboarding@resend.dev. Set once kmgrowth.in is
# verified in Resend, e.g. "KM Growth <hello@kmgrowth.in>"
CONTACT_FROM_EMAIL=

# ── Analytics (optional) ─────────────────────────────────────────
# Optional override. The GA4 measurement ID is already set in
# site.config.ts → analytics.gaMeasurementId (G-VB2WTS2LCT).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification token (the content="..."
# value only). Leave empty if you verify via DNS instead.
NEXT_PUBLIC_GSC_VERIFICATION=
